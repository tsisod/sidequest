{
  "name": "utopia-hackathon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "convex dev",
    "build": "pnpm typecheck && vite build",
    "build:vercel": "convex deploy --cmd 'pnpm build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "typecheck": "tsc -b && tsc --project convex/tsconfig.json && tsc --project tsconfig.tests.json",
    "lint": "oxlint --deny-warnings",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "convex": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
